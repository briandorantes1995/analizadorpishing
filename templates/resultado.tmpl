<div class="bg-white rounded-xl shadow-sm border {{ .border }} p-6">

    <div class="flex items-center gap-3">
        <span class="text-2xl">{{ .icon }}</span>

        <div>
            <h2 class="text-xl font-semibold {{ .titleColor }}">
                {{ .message }}
            </h2>

            <p class="text-slate-500">
                Risk Score: {{ .score }}/100
            </p>
        </div>
    </div>

    <details class="mt-6">
        <summary class="cursor-pointer text-slate-600 font-medium">
            Ver detalles completos
        </summary>

        <pre class="mt-4 bg-slate-100 rounded-lg p-4 overflow-auto text-xs">
{{ .json }}
        </pre>
    </details>

</div>