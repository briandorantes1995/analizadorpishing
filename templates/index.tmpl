<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{ .title }}</title>
     <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"></script>
</head>
<body class="bg-slate-100 min-h-screen">
   <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
   <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">

            <h1 class="text-2xl font-semibold text-slate-800 mb-6">{{ .title }}</h1>
  <form hx-encoding='multipart/form-data' hx-post='/analize' hx-target="#resultado" hx-swap="innerHTML"
          _='on htmx:xhr:progress(loaded, total) set #progress.value to (loaded/total)*100'>
        <input type='file' name='file'>
        <button type="submit" class="px-4 py-2 rounded-lg bg-slate-800 text-white hover:bg-slate-700 transition">
        Subir Archivo para Análisis
        </button>
        <progress id='progress' value='0' max='100'></progress>
    </form>
 </div>
   <pre id="resultado" class="mt-6 bg-white rounded-xl shadow-sm border border-slate-200 p-4 overflow-auto text-sm text-slate-800"> </pre>
    </div>
</body>
</html>

